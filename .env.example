# ============================================================
# HackRx Insurance API — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual keys:
#   cp .env.example .env
# ============================================================

# Pinecone — embedding queries (multilingual-e5-large) + BGE reranking
# https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key-here

# Groq — fast LLM inference  (set provider: groq in config.yaml)
# https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Gemini — Google LLM  (set provider: gemini in config.yaml)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================
# LLMOps & Observability
# ============================================================

# DagsHub / MLflow — used for experiment tracking
# https://dagshub.com/
DAGSHUB_TOKEN=your-dagshub-personal-access-token
DAGSHUB_REPO_OWNER=your-dagshub-username
DAGSHUB_REPO_NAME=your-repo-name
